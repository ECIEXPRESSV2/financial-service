# --- Base de datos (PostgreSQL en NeonDB) ---
DATABASE_URL=                        # NeonDB, con sslmode=require

# --- Bus de eventos (RabbitMQ en CloudAMQP) ---
RABBITMQ_URL=                        # CloudAMQP, formato amqps://user:pass@host/vhost

# --- Pasarela de pagos Wompi (sandbox) ---
WOMPI_PUBLIC_KEY=                    # pub_test_...
WOMPI_PRIVATE_KEY=                   # prv_test_...
WOMPI_EVENTS_SECRET=                 # secreto de eventos para validar webhooks
WOMPI_INTEGRITY_SECRET=              # secreto de integridad para firmar transacciones

# --- Comprobantes de pago (Azure Blob Storage, contenedor privado) ---
AZURE_STORAGE_CONNECTION_STRING=   # DefaultEndpointsProtocol=...;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
PAYMENT_RECEIPTS_CONTAINER=payment-receipts
PAYMENT_RECEIPTS_SAS_TTL_MINUTES=60  # vigencia del SAS de lectura de los comprobantes

# --- Comisiones por defecto al crear un negocio ---
DEFAULT_PLATFORM_FEE_PERCENT=5
DEFAULT_PEAK_FEE_PERCENT=3

# --- Liquidación mensual automática de saldos a las tiendas (simulada en sandbox) ---
MONTHLY_SETTLEMENT_CRON=0 6 1 * *   # 6:00am el día 1 de cada mes (TZ=America/Bogota)

# --- General ---
NODE_ENV=development
PORT=3004
TZ=America/Bogota
